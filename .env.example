# Exchange credentials (Binance Testnet to start)
EXCHANGE=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Set to 'true' for Binance Testnet / paper trading (ALWAYS start here)
PAPER_TRADE=true

# Trading pair and timeframe
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Strategy settings (Moving Average Crossover)
SHORT_PERIOD=9
LONG_PERIOD=21

# Risk management
MAX_TRADE_PERCENT=0.05       # Max 5% of balance per trade
STOP_LOSS_PERCENT=0.02       # 2% stop loss
TAKE_PROFIT_PERCENT=0.04     # 4% take profit
MAX_DAILY_LOSS_PERCENT=0.10  # Stop bot if 10% lost in a day

# MongoDB
MONGO_URI=mongodb://localhost:27017/tradebot

# How often to run the strategy (cron format - every hour)
CRON_SCHEDULE=0 * * * *
